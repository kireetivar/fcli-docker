# Non-secret settings only. Keep actual credentials in the three secret files.
# Stable fcli release; verify the archive checksum and Fortify RSA signature.
FCLI_VERSION=v3.28.0
FCLI_SHA256=f1c272513e24c204abd700037d373b831131520e805b2b8409025e619f8b04f6
BULK_AUDIT_IMAGE=fcli-bulk-audit:3.28.0-poc.3
SSC_URL=https://CHANGE_ME/ssc
# Set true to pass -k at SSC login and disable SSC TLS certificate verification.
SSC_INSECURE=false
AVIATOR_URL=https://CHANGE_ME
AVIATOR_TENANT=CHANGE_ME
# Optional SSC inclusion filter. Empty considers all eligible versions within max-audits.
BULK_AUDIT_FILTER=
BULK_AUDIT_ACTION=bulkaudit-sast
BULK_AUDIT_DRY_RUN=true
BULK_AUDIT_MAX_AUDITS=1
BULK_AUDIT_TIMEOUT_SECONDS=3600
